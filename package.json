{
    "name": "tintora",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/felipevlourenco/tintora.git"
    },
    "homepage": "https://felipevlourenco.github.io/tintora/",
    "description": "A lightweight React component library and design system for building polished UIs.",
    "keywords": [
        "react",
        "ui",
        "components",
        "design-system",
        "tintora"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./dist/tintora.css"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json --noEmit false --emitDeclarationOnly --declaration --outDir dist",
        "dev": "vite build --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint . && node scripts/check-tokens.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build",
        "prepare": "husky"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.5",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "clsx": "^2.1.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "semantic-release": "^25.0.9",
        "storybook": "^10.6.1",
        "storybook-addon-pseudo-states": "^10.6.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@12.11.2"
}
